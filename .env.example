# Ultralytics Platform API key (Settings → API Keys)
ULTRALYTICS_API_KEY=

# Full endpoint URL from the deployment's Predict tab, e.g.
# https://predict-abc123-xyz.a.run.app
# A trailing /predict is added automatically if you omit it.
ULTRALYTICS_ENDPOINT=

# Match confidence threshold (default 0.6). Lower this if your model
# detects the person but below 60% confidence, e.g. 0.55 for 55%.
MATCH_CONFIDENCE=0.6
